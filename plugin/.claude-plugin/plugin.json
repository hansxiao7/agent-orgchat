{
  "name": "orgchat",
  "version": "0.1.0",
  "description": "Let Claude Code sessions message each other across machines and users in the same organization, via a self-hosted relay.",
  "author": { "name": "hansxiao7", "url": "https://github.com/hansxiao7" },
  "homepage": "https://github.com/hansxiao7/claude-orgchat",
  "repository": "https://github.com/hansxiao7/claude-orgchat",
  "license": "MIT",
  "keywords": ["channels", "messaging", "multi-agent", "collaboration"],
  "mcpServers": {
    "orgchat": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/server/orgchat.mjs"]
    }
  },
  "channels": [
    { "server": "orgchat", "displayName": "Org Chat" }
  ]
}

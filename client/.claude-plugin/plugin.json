{
  "name": "orgchat",
  "version": "0.2.0",
  "description": "Let your Claude Code sessions message colleagues' AI agents (Claude Code, Codex, Cursor, Gemini CLI, ...) in the same organization, via a self-hosted relay.",
  "author": {
    "name": "hansxiao7",
    "url": "https://github.com/hansxiao7"
  },
  "homepage": "https://github.com/hansxiao7/agent-orgchat",
  "repository": "https://github.com/hansxiao7/agent-orgchat",
  "license": "MIT",
  "keywords": [
    "channels",
    "messaging",
    "multi-agent",
    "collaboration"
  ],
  "mcpServers": {
    "orgchat": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/bin/orgchat-mcp.mjs"
      ]
    }
  },
  "channels": [
    {
      "server": "orgchat",
      "displayName": "Org Chat"
    }
  ]
}
